# Server host di prova
PORT=3001
API_PREFIX=api
FRONTEND_ORIGIN=*

# Database Accessi esterno
ACCESSI_FIREBIRD_HOST=192.168.0.151
ACCESSI_FIREBIRD_PORT=3051
ACCESSI_FIREBIRD_DATABASE=C:\\db\\sterilix\\accessi.fdb
ACCESSI_FIREBIRD_USER=SYSDBA
ACCESSI_FIREBIRD_PASSWORD=replace-me
ACCESSI_FIREBIRD_WIRE_CRYPT=
ACCESSI_FIREBIRD_AUTH_PLUGIN=

# Accessi application
ACCESSI_ENCRYPTION_KEY=replace-with-a-long-random-key
ACCESSI_JWT_SECRET=replace-with-a-long-random-jwt-secret
ACCESSI_JWT_EXPIRES=24h
ACCESSI_AUTO_UPDATE_DATABASE=true
ACCESSI_LEGACY_PASSWORD_MIGRATION_ON_STARTUP=true
ACCESSI_PASSWORD_EXPIRATION=false
ACCESSI_PASSWORD_EXPIRATION_DAYS=
ACCESSI_MOCK_DEMO_USER=false
ACCESSI_PUBLIC_RATE_LIMIT_ENABLED=true
ACCESSI_CONFIRMATION_EMAIL_URL=http://localhost:3001
ACCESSI_CONFIRMATION_RETURN_EMAIL_URL=http://localhost:4200/#/login
ACCESSI_CUSTOM_RESET_PAGE=http://localhost:4200/#/login
ACCESSI_CONFIRMATION_EMAIL_PREFIX=

# Accessi e-mail
ACCESSI_EMAIL_HOST=smtp.example.invalid
ACCESSI_EMAIL_PORT=465
ACCESSI_EMAIL_SECURE=true
ACCESSI_EMAIL_REQUIRE_TLS=true
ACCESSI_EMAIL_TLS_REJECT_UNAUTHORIZED=false
ACCESSI_EMAIL_FROM=accessi@example.invalid
ACCESSI_EMAIL_USER=accessi@example.invalid
ACCESSI_EMAIL_PASSWORD=replace-me

# SSO generico: il backend reale valida Azure/Google/Apple e poi chiama
# FederatedAuthService. La console gestisce solo provisioning e collegamenti.
ACCESSI_FEDERATED_ENABLED=true
ACCESSI_FEDERATED_AUTO_UPDATE_SCHEMA=false
ACCESSI_FEDERATED_ALLOW_SELF_REGISTRATION=false
