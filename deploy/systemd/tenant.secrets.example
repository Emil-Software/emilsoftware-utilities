# Esempio di file segreti per un tenant systemd.
# Copiare in /etc/accessi/tenants/<id>.secrets con permessi 0600.
# Non committare valori reali.

ACME_DB_PASSWORD=<db-password>
ACME_JWT_SECRET=<jwt-secret-almeno-32-caratteri>
ACME_JWT_PRIVATE_KEY=<pem-su-una-riga-con-\n>
ACME_JWT_PUBLIC_KEY=<pem-su-una-riga-con-\n>
ACME_ENCRYPTION_KEY=<32-caratteri-casuali>
ACME_SMTP_USER=<smtp-user>
ACME_SMTP_PASSWORD=<smtp-password>
