{
  "name": "emilsoftware-utilities",
  "version": "2.0.0-dev.92",
  "description": "Utilities for EmilSoftware",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "accessi/*": [
        "dist/accessi/*"
      ]
    }
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/firebirdCompat.js",
    "./dist/accessi-service/console/console.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./accessi/server": {
      "types": "./dist/accessi/server/index.d.ts",
      "require": "./dist/accessi/server/index.js",
      "import": "./dist/accessi/server/index.js",
      "default": "./dist/accessi/server/index.js"
    },
    "./accessi/contracts": {
      "types": "./dist/accessi/contracts/index.d.ts",
      "require": "./dist/accessi/contracts/index.js",
      "import": "./dist/accessi/contracts/index.js",
      "default": "./dist/accessi/contracts/index.js"
    },
    "./accessi/contracts/dtos": {
      "types": "./dist/accessi/contracts/dtos.d.ts",
      "require": "./dist/accessi/contracts/dtos.js",
      "import": "./dist/accessi/contracts/dtos.js",
      "default": "./dist/accessi/contracts/dtos.js"
    },
    "./accessi/resource-server": {
      "types": "./dist/accessi/resource-server/index.d.ts",
      "require": "./dist/accessi/resource-server/index.js",
      "import": "./dist/accessi/resource-server/index.js",
      "default": "./dist/accessi/resource-server/index.js"
    },
    "./accessi/resource-server/core": {
      "types": "./dist/accessi/resource-server/core.d.ts",
      "require": "./dist/accessi/resource-server/core.js",
      "import": "./dist/accessi/resource-server/core.js",
      "default": "./dist/accessi/resource-server/core.js"
    },
    "./accessi/resource-server/express": {
      "types": "./dist/accessi/resource-server/express.d.ts",
      "require": "./dist/accessi/resource-server/express.js",
      "import": "./dist/accessi/resource-server/express.js",
      "default": "./dist/accessi/resource-server/express.js"
    },
    "./accessi/resource-server/nest": {
      "types": "./dist/accessi/resource-server/nest.d.ts",
      "require": "./dist/accessi/resource-server/nest.js",
      "import": "./dist/accessi/resource-server/nest.js",
      "default": "./dist/accessi/resource-server/nest.js"
    },
    "./accessi/client": {
      "types": "./dist/accessi/client/index.d.ts",
      "require": "./dist/accessi/client/index.js",
      "import": "./dist/accessi/client/index.js",
      "default": "./dist/accessi/client/index.js"
    },
    "./accessi/client/public": {
      "types": "./dist/accessi/client/public/index.d.ts",
      "require": "./dist/accessi/client/public/index.js",
      "import": "./dist/accessi/client/public/index.js",
      "default": "./dist/accessi/client/public/index.js"
    },
    "./accessi/client/admin": {
      "types": "./dist/accessi/client/admin/index.d.ts",
      "require": "./dist/accessi/client/admin/index.js",
      "import": "./dist/accessi/client/admin/index.js",
      "default": "./dist/accessi/client/admin/index.js"
    },
    "./accessi/client/service": {
      "types": "./dist/accessi/client/service/index.d.ts",
      "require": "./dist/accessi/client/service/index.js",
      "import": "./dist/accessi/client/service/index.js",
      "default": "./dist/accessi/client/service/index.js"
    },
    "./accessi/openapi": {
      "types": "./dist/accessi/openapi/index.d.ts",
      "require": "./dist/accessi/openapi/index.js",
      "import": "./dist/accessi/openapi/index.js",
      "default": "./dist/accessi/openapi/index.js"
    },
    "./accessi/console": {
      "types": "./dist/accessi/console/index.d.ts",
      "require": "./dist/accessi/console/index.js",
      "import": "./dist/accessi/console/index.js",
      "default": "./dist/accessi/console/index.js"
    },
    "./accessi/console/index.html": "./dist/accessi-service/console/index.html",
    "./accessi/console/console.js": "./dist/accessi-service/console/console.js",
    "./accessi/console/console.css": "./dist/accessi-service/console/console.css",
    "./accessi/ui": {
      "types": "./dist/accessi/ui/index.d.ts",
      "require": "./dist/accessi/ui/index.js",
      "import": "./dist/accessi/ui/index.js",
      "default": "./dist/accessi/ui/index.js"
    },
    "./accessi/ui/aree-disponibili": "./dist/angular-components/aree-disponibili/aree-disponibili.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "release": "semantic-release",
    "build": "npm run generate:accessi-openapi && npm run check:accessi-openapi && npm run check:accessi-openapi-diff && npm run generate:accessi-client && npm run generate:accessi-wiki && tsc && tsc -p tsconfig.console.json --noEmit && npm run build:accessi-console && npm run copy-views",
    "check:accessi-openapi": "node scripts/check-accessi-openapi.cjs",
    "accessi:update-openapi-fingerprint": "node scripts/check-accessi-openapi.cjs --update",
    "check:accessi-openapi-diff": "node scripts/openapi-semantic-diff.cjs",
    "accessi:update-openapi-baseline": "node scripts/openapi-semantic-diff.cjs --update",
    "generate:accessi-openapi": "ts-node --transpile-only src/scripts/generateAccessiOpenApi.ts",
    "generate:accessi-client": "orval --config orval.config.ts",
    "generate:accessi-wiki": "ts-node --transpile-only src/scripts/generateAccessiWiki.ts",
    "build:accessi-console": "esbuild src/accessi-service/console/console.ts --bundle --platform=browser --format=esm --target=es2020 --loader:.md=text --outfile=dist/accessi-service/console/console.js",
    "copy-views": "node scripts/copy-views.cjs",
    "db:update:accessi": "ts-node src/accessi-service/database-updates/runAccessiDbUpdate.ts",
    "db:update:accessi:dist": "npm run build && node dist/accessi-service/database-updates/runAccessiDbUpdate.js",
    "accessi:serve": "ts-node src/scripts/startAccessiService.ts",
    "accessi:serve:dist": "node dist/scripts/startAccessiService.js",
    "accessi:tenants": "node scripts/accessi-tenants.cjs",
    "accessi:generate-jwt-keys": "node scripts/generate-accessi-jwt-keys.cjs",
    "accessi:rotate-jwt-keys": "node scripts/rotate-accessi-jwt-keys.cjs",
    "db:catalog:accessi": "ts-node src/accessi-service/database-updates/runAccessiCatalogMigrations.ts",
    "db:catalog:accessi:check": "ts-node src/accessi-service/database-updates/runAccessiCatalogMigrations.ts --check",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.cjs",
    "check:deploy": "node scripts/check-deploy-templates.cjs",
    "test": "npm run typecheck && npm run lint && npm run check:naming && npm run test:unit",
    "test:unit": "node --test \"test/*.cjs\" \"test/*.mjs\"",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=50 --test-coverage-functions=60 --test-coverage-branches=60 --test \"test/*.cjs\" \"test/*.mjs\"",
    "test:accessi": "npm run test:unit",
    "test:all": "npm test && npm run test:integration && npm run test:integration:redis",
    "test:integration": "node test/integration/run-firebird.cjs 5",
    "test:integration:redis": "node --test --test-concurrency=1 test/integration/redis-stores.integration.cjs test/integration/redis-tenant-stores.integration.cjs",
    "test:load:redis": "node --test --test-concurrency=1 test/integration/redis-load.integration.cjs",
    "test:integration:fb5": "node test/integration/run-firebird.cjs 5",
    "test:integration:fb3": "node test/integration/run-firebird.cjs 3",
    "test:integration:fb25": "node test/integration/run-firebird.cjs 2.5",
    "test:accessi-console": "npm run build && node test/console/console-two-factor.cjs",
    "test:pack": "node scripts/pack-smoke-test.cjs",
    "test:proxy-ip": "node --test test/proxy-ip.cjs test/readiness.cjs",
    "accessi:seed-admin": "node scripts/seed-accessi-admin.cjs",
    "accessi:console": "node scripts/run-accessi-console.cjs",
    "test:accessi-schema": "node --test test/accessi-schema.cjs",
    "db:check:accessi": "ts-node src/accessi-service/database-updates/runAccessiDbUpdate.ts --check",
    "menus:init": "node scripts/menus/init.mjs",
    "menus:verify": "node scripts/menus/verify.mjs",
    "menus:generate": "node scripts/menus/generate.mjs",
    "menus:check": "node scripts/menus/generate.mjs --check",
    "menus:bootstrap": "node scripts/menus/bootstrap.mjs",
    "menus:seed": "node scripts/menus/seed.mjs",
    "menus:seed:check": "node scripts/menus/seed.mjs --check",
    "check:naming": "node scripts/check-naming.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emil-Software/emilsoftware-utilities.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Emil-Software/emilsoftware-utilities/issues"
  },
  "homepage": "https://github.com/Emil-Software/emilsoftware-utilities#readme",
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "colorette": "^2.0.20",
    "jiti": "^2.7.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "multer": "^2.5.0",
    "node-fetch": "^3.3.2",
    "node-firebird": "^2.19.1",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/reflect-metadata": "^0.1.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.2",
    "fs-extra": "^11.4.1",
    "orval": "^8.46.0",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "multer": "$multer"
  },
  "files": [
    "dist",
    "deploy",
    "integration-prompt.md",
    "docs",
    "SECURITY.md"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
